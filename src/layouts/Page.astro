---
import '../styles/almanac.css';
import { url } from '../lib/url';

interface Props {
  title: string;
}

const { title } = Astro.props;
const rootstockUrl = import.meta.env.PUBLIC_ROOTSTOCK_URL;

const homeHref = url('/');
const leekSrc = url('/old_timey_leek.png');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const wordmark = "Garden's Almanac of Matter Models";

const primaryNav = [
  { href: url('/'), label: 'Availability' },
  { href: url('/models'), label: 'Models' },
  { href: url('/clusters'), label: 'Clusters' },
  { href: url('/datasets'), label: 'Datasets' },
];

const norm = (h: string) => (h.replace(/\/$/, '') || '/');
const isCurrent = (href: string) => norm(href) === norm(path);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="64x64" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <script is:inline>
      // Unlisted-cluster unlock (see `unlisted` in content.config.ts).
      // ?gotigers=true unlocks and persists; ?gotigers=false relocks. Runs
      // pre-paint so unlocked rows never flash in and out.
      (() => {
        try {
          const q = new URLSearchParams(location.search).get('gotigers');
          if (q === 'true') localStorage.setItem('am-gotigers', '1');
          else if (q === 'false') localStorage.removeItem('am-gotigers');
          if (localStorage.getItem('am-gotigers'))
            document.documentElement.classList.add('gotigers');
        } catch {}
      })();
    </script>
    {rootstockUrl && <link rel="prefetch" href={rootstockUrl} as="fetch" crossorigin="anonymous" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500&family=IM+Fell+English+SC&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <article class="page">
      <header class="site-head">
        <a class="home-link site-head-mark" href={homeHref} aria-label={`${wordmark} — home`}>
          <img class="home-leek" src={leekSrc} alt="" width="102" height="160" />
          <span class="home-wordmark">{wordmark}</span>
        </a>
        <nav class="site-head-nav" aria-label="Primary">
          {primaryNav.map((l) => (
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
          ))}
        </nav>
      </header>
      <slot />
      <footer class="site-foot">
        <p>
          This work is supported by
          {' '}<a class="ink-link" href="https://www.nsf.gov/awardsearch/showAward?AWD_ID=2209892">NSF Award #2209892</a>:
          “Frameworks: Garden: A FAIR Framework for Publishing and Applying AI Models for
          Translational Research in Science, Engineering, Education, and Industry”
        </p>
      </footer>
    </article>
  </body>
</html>
