---
import { getCollection, getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import SimilarityTree from '../components/SimilarityTree.astro';
import { url } from '../lib/url';
import { yearOf } from '../lib/format';

const allModels = await getCollection('models');

// Catalogue rail — every model, most-recent-first, name + year only.
const enriched = await Promise.all(
  allModels.map(async (m) => {
    let resolvedDate = m.data.releaseDate ?? null;
    if (!resolvedDate) {
      for (const ref of m.data.paperRefs) {
        const p = await getEntry('papers', ref.id);
        if (p?.data.published) { resolvedDate = p.data.published; break; }
      }
    }
    return { model: m, resolvedDate, year: yearOf(resolvedDate) };
  }),
);
const models = enriched.sort((a, b) => {
  if (!a.resolvedDate && !b.resolvedDate) return a.model.data.name.localeCompare(b.model.data.name);
  if (!a.resolvedDate) return 1;
  if (!b.resolvedDate) return -1;
  return b.resolvedDate.localeCompare(a.resolvedDate);
});

// Architecture Families — full-width below the split (merged in from the deleted
// /architectures page). Each family's brief, representative paper, and label all
// come from its architectures-collection JSON; families with no catalog models
// are dropped, and reappear automatically if ever repopulated.
// Roughly earliest-to-latest by each family's lineage / representative paper.
const FAMILY_ORDER = ['fixed-descriptor', 'mpnn', 'equivariant', 'ace', 'learned-symmetry', 'attention'];
const families = (await getCollection('architectures')).sort(
  (a, b) => FAMILY_ORDER.indexOf(a.id) - FAMILY_ORDER.indexOf(b.id),
);
const modelsByFamily: Record<string, Array<{ id: string; name: string }>> = {};
for (const f of families) {
  modelsByFamily[f.id] = allModels
    .filter((m) => m.data.families.some((ref) => ref.id === f.id))
    .map((m) => ({ id: m.id, name: m.data.name }))
    .sort((a, b) => a.name.localeCompare(b.name));
}
const familyCards = await Promise.all(
  families
    .filter((f) => modelsByFamily[f.id].length > 0)
    .map(async (f) => {
      const paper = f.data.examplePaper ? await getEntry(f.data.examplePaper) : null;
      return {
        id: f.id,
        name: f.data.name,
        brief: f.data.brief,
        paperLabel: f.data.examplePaperLabel ?? '',
        paperUrl: paper?.data.url ?? null,
      };
    }),
);
---

<Page title="Models — Garden's Almanac">
  <div class="models-page">
    <h1 class="models-h1">Models</h1>

    <p class="page-dek">
      Machine-learned interatomic potentials, grouped by
      <a class="ink-link" href="#similarity">similarity of representation</a>, by
      <a class="ink-link" href="#families">architecture family</a>, and by
      <a class="ink-link" href="#years">publication year</a>.
    </p>

    <section id="similarity" class="models-section">
      <hr class="models-rule" />
      <h2 class="models-h2">By Similarity of Representation</h2>
      <SimilarityTree />
    </section>

    {familyCards.length > 0 && (
      <section id="families" class="models-section">
        <hr class="models-rule" />
        <h2 class="models-h2">By Architecture Family</h2>
        <div class="models-families-grid">
          {familyCards.map((f) => (
            <div class="models-family" id={f.id}>
              <h3 class="models-family-h3">{f.name}</h3>
              <p class="models-family-brief">{f.brief}</p>
              <div class="models-family-models">
                <span class="sc models-family-k">Models</span>
                {modelsByFamily[f.id].map((m, i) => (
                  <>
                    {i > 0 && <span class="models-family-sep" aria-hidden="true">·</span>}
                    <a class="ink-link it" href={url(`/model/${m.id}`)}>{m.name}</a>
                  </>
                ))}
              </div>
              {f.paperUrl && (
                <p class="models-family-paper">
                  <span class="sc models-family-k">Example paper</span>
                  <a class="ink-link it" href={f.paperUrl} target="_blank" rel="noopener">{f.paperLabel}</a>
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <section id="years" class="models-section">
      <hr class="models-rule" />
      <h2 class="models-h2">By Publication Year</h2>
      <div class="models-years-cols">
        {models.map(({ model: m, year }) => (
          <div class="models-rail-row">
            <a class="ink-link it models-rail-name" href={url(`/model/${m.id}`)}>{m.data.name}</a>
            <span class="mono models-rail-year">{year ?? '—'}</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</Page>

<style>
  .models-h1 {
    font-family: var(--serif); font-size: var(--fs-h1); font-weight: 600;
    line-height: 1; letter-spacing: -0.01em; margin: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html) { scroll-behavior: smooth; }
  }

  .models-section { margin-top: 38px; }
  .models-section:first-of-type { margin-top: 20px; }
  .models-rule {
    border: 0; border-top: 1.5px solid var(--ink); border-bottom: 0.5px solid var(--ink);
    height: 3px; margin: 0 0 12px;
  }
  .models-h2 {
    font-family: var(--smallcaps); text-transform: lowercase; font-weight: 400;
    font-size: var(--fs-h3); letter-spacing: var(--track-display);
    line-height: 1.2; margin: 0 0 18px; color: var(--ink);
  }

  .models-years-cols { columns: 170px; column-gap: 48px; }
  .models-rail-row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 10px; padding: 6px 1px; border-bottom: 0.5px solid var(--rule-soft);
    break-inside: avoid;
  }
  .models-rail-name { font-size: var(--fs-base); min-width: 0; }
  .models-rail-year {
    font-size: var(--fs-sm); color: var(--ink-3); flex: 0 0 auto;
    font-variant-numeric: tabular-nums;
  }

  .models-families-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(440px, 1fr)); gap: 0 44px; }
  .models-family { padding: 16px 0 18px; border-top: 0.5px solid var(--rule); scroll-margin-top: 24px; }
  .models-family-h3 {
    font-family: var(--serif); font-size: var(--fs-h3); font-weight: 600;
    line-height: 1.15; letter-spacing: -0.003em; margin: 0;
  }
  .models-family-brief { font-size: var(--fs-md); line-height: 1.5; color: var(--ink); margin: 6px 0 0; }
  .models-family-models { margin-top: 10px; font-size: var(--fs-md); line-height: 1.7; }
  .models-family-paper { margin: 6px 0 0; font-size: var(--fs-md); line-height: 1.6; }
  .models-family-k {
    font-size: var(--fs-base); letter-spacing: var(--track-label); color: var(--ink-3); margin-right: 4px;
  }
  .models-family-sep { color: var(--ink-3); margin: 0 6px 0 7px; }

  @media (max-width: 720px) {
    .models-families-grid { grid-template-columns: 1fr; }
  }
</style>
