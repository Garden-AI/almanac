---
import { getCollection, getEntry } from 'astro:content';
import { marked } from 'marked';
import Page from '../../layouts/Page.astro';
import { getRootstockDump, findVerification, cellStateFor, statusGlyph, envFilesForModel, envCaption, renderEnvBody, type CellState } from '../../lib/rootstock';
import { url } from '../../lib/url';
import { formatMonthYear, yearOf } from '../../lib/format';
import { getSortedClusters } from '../../lib/clusters';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((m) => ({ params: { slug: m.id }, props: { model: m } }));
}

const { model } = Astro.props;

const families = await Promise.all(
  model.data.families.map((ref) => getEntry('architectures', ref.id)),
);
const trainingDatasets = await Promise.all(
  model.data.trainingData.map((ref) => getEntry('datasets', ref.id)),
);
const papers = await Promise.all(
  model.data.paperRefs.map((ref) => getEntry('papers', ref.id)),
);

// Completeness check: any paper referenced by a model must have at minimum
// title, authors, published, url. Stubs (just doi+source) fail loudly so
// shipping a model that points at an unfilled stub isn't possible.
for (const p of papers) {
  if (!p) continue;
  const d = p.data;
  const incomplete = !d.title || !d.authors?.length || !d.published || !d.url;
  if (incomplete && d.source === 'fetched') {
    throw new Error(
      `Paper '${p.id}' is a stub. Run npm run fetch:papers.`,
    );
  }
}

// Resolved release date: explicit override, else first paper's `published`.
const primaryPaper = papers.find((p) => p?.data.published) ?? null;
const resolvedDate = model.data.releaseDate ?? primaryPaper?.data.published ?? null;
const dateLine = formatMonthYear(resolvedDate);

const allClusters = await getSortedClusters();

const dump = await getRootstockDump();

// Render a column for *every* cluster. Columns where the current dump shows
// no presence get an `am-hidden` class server-side; the live-refresh script
// re-derives that per column, so a stale build can't strand a real cluster.
const matrix = model.data.checkpoints.map((cp) => ({
  checkpoint: cp,
  cells: allClusters.map((c) => {
    const v = findVerification(dump, c.id, cp.id);
    return {
      cluster: c,
      state: cellStateFor(v) as CellState,
      verifiedAt: v?.verifiedAt ?? null,
      lastError: v?.lastError ?? null,
    };
  }),
}));

// The env's bring-your-own-weights pseudo-checkpoint, when curated. It gets
// a row in the table and a snippet toggle, both governed by the same
// live-presence rules as everything else: invisible until Rootstock reports
// the id, no special-casing beyond the shared-across-models dedupe.
const customId = model.data.customCheckpoint ?? null;
const checkpointIds = model.data.checkpoints.map((cp) => cp.id);
/** Every id this page tracks presence for — shipped checkpoints + custom. */
const presenceIds = customId ? [...checkpointIds, customId] : checkpointIds;

const customCells = customId
  ? allClusters.map((c) => ({
      cluster: c,
      state: cellStateFor(findVerification(dump, c.id, customId)) as CellState,
    }))
  : [];
// Same unlock rule as everywhere: unlisted clusters don't make the custom
// row (or its toggle) visible for regular viewers.
const customRowPresent = customCells.some(
  (cell) => !cell.cluster.data.unlisted && cell.state !== 'na',
);

const clusterHasPresence: Record<string, boolean> = {};
for (const c of allClusters) {
  clusterHasPresence[c.id] = presenceIds.some(
    (id) => findVerification(dump, c.id, id) !== null,
  );
}
// Unlisted clusters don't count toward "anyone has this" — the egg-off
// baseline. The live script re-derives this with the viewer's unlock state.
const anyPresence = allClusters.some(
  (c) => !c.data.unlisted && clusterHasPresence[c.id],
);

// "Running this model" — curated invocation facts (heads / model inputs /
// license). These are catalog identity, not Rootstock state: build-time only,
// no live refresh. Aggregated across checkpoints for the args table; the
// checkpoint table above stays the per-checkpoint truth (heads rosters, ±).
//
// Two distinct mechanisms, per Rootstock's docs (docs/api.md):
//  - heads are picked at construction: `setup_kwargs={"task": "omol"}`,
//    forwarded to the env's setup();
//  - model inputs (charge, spin, external_field, …) are per-calculation
//    physics, set on `atoms.info` and forwarded with every calculation.
const headsSpec = model.data.checkpoints.find((cp) => cp.heads)?.heads ?? null;
const modelInputs = [...new Set(model.data.checkpoints.flatMap((cp) => cp.modelInputs ?? []))];

/** Example atoms.info lines for the known model-input keys. Unknown keys
 *  fall back to a placeholder — curators extend this as new model families
 *  need it. No defaults anywhere: what a model assumes when a key is unset
 *  is the model's own behavior, not something Rootstock sets or knows. */
const INPUT_EXAMPLES: Record<string, string> = {
  charge: 'atoms.info["charge"] = -1',
  spin: 'atoms.info["spin"] = 2',
  external_field: 'atoms.info["external_field"] = [0, 0, 0.1]',
};
const listWithAnd = (xs: string[]): string =>
  xs.length <= 1 ? (xs[0] ?? '') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;

// Heads table: each head resolved to the catalog dataset it was trained
// against — head names track training corpora, so the dataset link is the
// answer to "what is omol?". Gloss comes from the dataset's own record.
const headRows = headsSpec
  ? await Promise.all(
      headsSpec.values.map(async (v) => {
        const ds = v.dataset ? await getEntry(v.dataset) : null;
        return {
          id: v.id,
          isDefault: v.id === headsSpec.default,
          datasetId: ds?.id ?? null,
          datasetName: ds?.data.name ?? null,
          gloss: ds?.data.systemType ?? ds?.data.domain ?? null,
        };
      }),
    )
  : [];

// Worked example: generic cluster placeholder (naming one cluster misled —
// readers took it as *the* cluster, or saw one where the model isn't
// installed), the first checkpoint, and — when heads exist — the omol head
// if there is one, so the model-input lines are physically coherent. The
// "eg" cluster names are this model's own (build-time best effort), so the
// examples are never clusters the model isn't on.
const clusterVerified: Record<string, boolean> = {};
for (const c of allClusters) {
  clusterVerified[c.id] = matrix.some((row) =>
    row.cells.some((cell) => cell.cluster.id === c.id && cell.state === 'verified'),
  );
}
// Verified clusters first — an "eg" naming a lapsed cluster repeats the
// original problem in miniature. Presence-only clusters back-fill, then a
// generic pair if the model is nowhere at build time.
const egClusters = allClusters
  .filter((c) => !c.data.unlisted && clusterHasPresence[c.id])
  .sort((a, b) => Number(clusterVerified[b.id]) - Number(clusterVerified[a.id]))
  .slice(0, 2)
  .map((c) => `"${c.id}"`);
const egLine = egClusters.length > 0 ? egClusters.join(', ') : '"polaris", "perlmutter"';
const exampleCheckpoint = model.data.checkpoints[0];
const exampleHead = headsSpec
  ? (headsSpec.values.some((v) => v.id === 'omol') ? 'omol' : headsSpec.default ?? headsSpec.values[0].id)
  : null;

const makeSnippet = (head: string | null, custom = false): string => {
  // Opens with the on-cluster framing: `cluster=` otherwise reads like a
  // cloud SDK's routing target, when it names the cluster you're already
  // logged into — the biggest Rootstock misunderstanding.
  const lines: string[] = ['# from a job or interactive session on a supported cluster:'];
  lines.push('from rootstock import RootstockCalculator', '');
  if (modelInputs.length > 0) {
    lines.push(`# this model accepts ${listWithAnd(modelInputs)}`);
    for (const key of modelInputs) {
      lines.push(INPUT_EXAMPLES[key] ?? `atoms.info["${key}"] = ...`);
    }
    lines.push('');
  }
  lines.push(
    'with RootstockCalculator(',
    `    cluster=YOUR_CLUSTER_ID,  # eg, ${egLine}`,
  );
  if (custom) {
    // The custom variant runs the user's own fine-tune: the `:custom` id
    // selects the env, `weights=` names their file (a first-class kwarg,
    // not a setup_kwarg — see Rootstock docs/api.md).
    lines.push(
      `    checkpoint="${customId}",`,
      '    weights=YOUR_WEIGHTS_PATH,  # must be visible from the compute nodes',
    );
  } else {
    lines.push(`    checkpoint="${exampleCheckpoint.id}",`);
  }
  lines.push('    device="cuda",');
  if (headsSpec && head) {
    lines.push(`    setup_kwargs={"${headsSpec.kwarg}": "${head}"},  # select a head`);
  }
  lines.push(
    ') as calc:',
    '    # model is now running in subprocess on compute node',
    '    atoms.calc = calc',
    '    atoms.get_potential_energy()',
  );
  return lines.join('\n');
};
const runningSnippet = makeSnippet(exampleHead);
// The snippet re-renders client-side from these templates: ?head=… pre-fills
// a head (no on-page picker UI), and the shipped/custom toggle — or a
// ?custom link from the matrix — swaps in the bring-your-own-weights variant.
const runConfig = (headsSpec || customId)
  ? {
      template: makeSnippet(headsSpec ? '@@HEAD@@' : null),
      customTemplate: customId ? makeSnippet(headsSpec ? '@@HEAD@@' : null, true) : null,
      heads: headsSpec ? headsSpec.values.map((v) => v.id) : [],
      defaultHead: exampleHead,
    }
  : null;

// Environments section: the verbatim env file Rootstock installs for this
// model, one tab per installed cluster (matrix order). Build-time seed only —
// the client re-derives the tab set + file bodies from the live dump (env text
// is live, per the build-vs-live rule in CLAUDE.md). `envConfig` gives the
// client what it needs to recompute against live data (cluster order + the
// model's checkpoint ids).
// Env-file tabs: the build seed excludes unlisted clusters (egg-off baseline);
// the client re-derives the tab set from `envConfig`, filtering by the
// viewer's unlock state — so unlocked viewers gain those tabs on live refresh.
// `presenceIds` (not just shipped checkpoints) so a cluster reporting only
// the custom pseudo-checkpoint still surfaces its env file.
const envFiles = envFilesForModel(
  dump,
  allClusters.filter((c) => !c.data.unlisted).map((c) => ({ id: c.id, name: c.data.name })),
  presenceIds,
);
const envConfig = {
  clusters: allClusters.map((c) => ({
    id: c.id,
    name: c.data.name,
    unlisted: c.data.unlisted ?? false,
  })),
  checkpoints: presenceIds,
};
// JSON embedded in <script type="application/json"> — neutralize any `<` so a
// stray `</script>` in env source can't close the tag early.
const jsonAttr = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');

const weightsDomainLabel = (u: string): string => {
  try {
    const h = new URL(u).hostname.replace(/^www\./, '');
    if (h.includes('zenodo.org')) return 'Zenodo';
    if (h.includes('github.com')) return 'GitHub Release';
    if (h.includes('figshare.com')) return 'Figshare';
    if (h.includes('huggingface.co')) return 'Hugging Face';
    return h;
  } catch {
    return 'Weights';
  }
};

const codeDomainLabel = (u: string): string => {
  try {
    const h = new URL(u).hostname.replace(/^www\./, '');
    if (h.includes('github.com')) return 'GitHub';
    if (h.includes('gitlab.com')) return 'GitLab';
    return h;
  } catch {
    return 'Code';
  }
};

const paperDomainLabel = (u: string): string => {
  try {
    const h = new URL(u).hostname.replace(/^www\./, '');
    if (h.includes('arxiv.org')) return 'arXiv';
    return h;
  } catch {
    return 'Paper';
  }
};

const paperLink = (() => {
  // Masthead Paper link: prefer the first paper's URL/DOI, else nothing.
  // When a DOI exists, the DOI string itself is the label (mono — it's an
  // identifier, not prose); a generic "DOI" label said nothing.
  const p = papers.find((p) => p?.data.url || p?.data.doi);
  if (!p) return null;
  if (p.data.doi)
    return { href: `https://doi.org/${p.data.doi}`, label: p.data.doi, mono: true };
  return { href: p.data.url!, label: paperDomainLabel(p.data.url!), mono: false };
})();

const composeCitation = (data: { authors?: string[]; title?: string; venue?: string; published?: string; citation?: string }): string => {
  if (data.citation) return data.citation;
  const parts: string[] = [];
  if (data.authors?.length) parts.push(data.authors.join(', '));
  if (data.title) parts.push(data.title);
  if (data.venue) parts.push(data.venue);
  const y = yearOf(data.published);
  if (y) parts.push(String(y));
  return parts.join(', ') + (parts.length ? '.' : '');
};

const notesHtml = model.data.notes ? marked.parse(model.data.notes) : null;
---
<Page title={`${model.data.name} — Garden's Almanac`}>
  <div class="model-masthead">
    <h1>{model.data.name}</h1>
    {dateLine && (
      <p class="it" style="font-size: var(--fs-base); color: var(--ink-2); margin-top: 6px;">
        {dateLine}
      </p>
    )}

    {(paperLink || model.data.codeUrl || model.data.huggingFaceId || model.data.weightsUrl || model.data.license) && (
      <div class="masthead-links">
        {paperLink && (
          <div class="masthead-link">
            <span class="sc">Paper</span>
            <a class:list={["ink-link", paperLink.mono && "mono"]}
               style={paperLink.mono ? 'font-size: var(--fs-md);' : undefined}
               href={paperLink.href} target="_blank" rel="noopener">
              {paperLink.label} <span style="color: var(--ink-3);">↗</span>
            </a>
          </div>
        )}
        {model.data.codeUrl && (
          <div class="masthead-link">
            <span class="sc">Code</span>
            <a class="ink-link" href={model.data.codeUrl} target="_blank" rel="noopener">
              {codeDomainLabel(model.data.codeUrl)} <span style="color: var(--ink-3);">↗</span>
            </a>
          </div>
        )}
        {model.data.huggingFaceId ? (
          <div class="masthead-link">
            <span class="sc">Weights</span>
            <span style="display: inline-flex; align-items: baseline; gap: 6px;">
              <span aria-hidden="true">🤗</span>
              <a class="ink-link mono" style="font-size: var(--fs-md);"
                 href={`https://huggingface.co/${model.data.huggingFaceId}`}
                 target="_blank" rel="noopener">{model.data.huggingFaceId}</a>
            </span>
          </div>
        ) : model.data.weightsUrl ? (
          <div class="masthead-link">
            <span class="sc">Weights</span>
            <a class="ink-link" href={model.data.weightsUrl} target="_blank" rel="noopener">
              {weightsDomainLabel(model.data.weightsUrl)} <span style="color: var(--ink-3);">↗</span>
            </a>
          </div>
        ) : null}
        {model.data.license && (
          <div class="masthead-link">
            <span class="sc">License</span>
            {model.data.license.url ? (
              <a class="ink-link" href={model.data.license.url} target="_blank" rel="noopener">
                {model.data.license.name} <span style="color: var(--ink-3);">↗</span>
              </a>
            ) : (
              <span>{model.data.license.name}</span>
            )}
          </div>
        )}
      </div>
    )}
  </div>

  <div style="height: 18px;"></div>

  <section class="checkpoint-matrix">
    <div style="overflow-x: auto;">
      <table class="almanac" style="font-size: var(--fs-md);">
        <thead>
          <tr>
            <th>Checkpoint</th>
            <th style="width: 80px; text-align: right;">Params</th>
            {allClusters.map((c) => (
              <th
                class:list={["am-mx-col", !clusterHasPresence[c.id] && "am-hidden", c.data.unlisted && "am-unlisted"]}
                data-rs-col={c.id}
                style="width: 84px; text-align: center;"
              >
                <a class="ink-link" href={url(`/clusters#${c.id}`)} style="border-bottom-color: transparent;">
                  {c.data.name}
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {matrix.map(({ checkpoint, cells }) => (
            <tr id={checkpoint.id}>
              <td class="mono" style="font-size: var(--fs-sm);">{checkpoint.id}</td>
              <td style="text-align: right; font-variant-numeric: tabular-nums;">
                {checkpoint.params ?? ''}
              </td>
              {cells.map((cell) => (
                <td
                  class:list={["am-mx-col", !clusterHasPresence[cell.cluster.id] && "am-hidden", cell.cluster.data.unlisted && "am-unlisted"]}
                  style="text-align: center;"
                  data-rs-col={cell.cluster.id}
                  data-rs-cell={`${cell.cluster.id}:${checkpoint.id}`}
                  set:html={statusGlyph(cell.state)}
                />
              ))}
            </tr>
          ))}
          {/* Bring-your-own-weights row: same live cell machinery, but the
              whole row hides when no (visible) cluster reports the id —
              unlike shipped rows, which always render. */}
          {customId && (
            <tr class:list={[!customRowPresent && "am-hidden"]} data-rs-custom-row>
              <td class="mono" style="font-size: var(--fs-sm);">{customId}</td>
              <td></td>
              {customCells.map((cell) => (
                <td
                  class:list={["am-mx-col", !clusterHasPresence[cell.cluster.id] && "am-hidden", cell.cluster.data.unlisted && "am-unlisted"]}
                  style="text-align: center;"
                  data-rs-col={cell.cluster.id}
                  data-rs-cell={`${cell.cluster.id}:${customId}`}
                  set:html={statusGlyph(cell.state)}
                />
              ))}
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div class:list={["matrix-legend", !anyPresence && "am-hidden"]} data-rs-legend>
      <span><span class="status-verified">●</span> <span class="it">verified, last 30 days</span></span>
      <span><span class="status-stale">○</span> <span class="it">installed, not recently verified</span></span>
      <span><span class="status-na">—</span> <span class="it">not installed</span></span>
    </div>
    <p
      class:list={["it", anyPresence && "am-hidden"]}
      data-rs-empty
      style="font-size: var(--fs-sm); color: var(--ink-2); margin-top: 8px;"
    >
      No cluster has installed any checkpoint of this model yet.
    </p>
  </section>

  {/* Every model gets this section — the base snippet (cluster, checkpoint,
      device) is the almanac's core promise; heads/license/inputs merely layer
      onto it. A conditional section made its absence ambiguous. */}
  <section class="running-section">
    <hr class="hairline" style="margin: 24px 0 0;" />
    <div class="sc" style="font-size: var(--fs-sm); letter-spacing: var(--track-label); margin-top: 12px;">Running this model</div>
      <div class:list={["running-grid", !headsSpec && "is-solo"]}>
        <div class="running-prose">
          {headsSpec && (
            <>
              <p>
                This model has task heads. You can select which output layer is active at inference time with
                {' '}<code>setup_kwargs={'{'}"{headsSpec.kwarg}": "{headsSpec.default ?? headRows[0]?.id}"{'}'}</code>.
              </p>
              <table class="almanac running-args running-heads" id="heads">
                <thead>
                  <tr>
                    <th>Task head</th>
                    <th>Trained against</th>
                  </tr>
                </thead>
                <tbody>
                  {headRows.map((h) => (
                    <tr>
                      <td>
                        <span class="mono">{h.id}</span>
                        {h.isDefault && <span class="running-head-default it">default</span>}
                      </td>
                      <td>
                        {h.datasetName ? (
                          <>
                            <a class="ink-link" href={url(`/datasets#${h.datasetId}`)}>{h.datasetName}</a>
                            {h.gloss && <span style="color: var(--ink-2);"> — {h.gloss}</span>}
                          </>
                        ) : (
                          '—'
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}
        </div>
        <div class="running-snippet-col">
          {/* Shipped/custom toggle — only when the env's custom entry is
              live-present somewhere visible (same rule as the table row). */}
          {customId && (
            <div class:list={["am-env-tabs", "run-toggle", !customRowPresent && "am-hidden"]} data-run-toggle>
              <button type="button" class="am-env-tab is-active" data-run-mode="shipped">pre-staged checkpoint</button>
              <button type="button" class="am-env-tab" data-run-mode="custom">custom checkpoint</button>
            </div>
          )}
          {/* No chrome bar: a filename here would suggest a file that exists in
              the system, and only the env files below actually do. */}
          <div class="am-env-block running-snippet">
            <div class="am-env-body" data-run-snippet set:html={renderEnvBody(runningSnippet)} />
          </div>
        </div>
      </div>
      {runConfig && (
        <script type="application/json" data-run-config set:html={jsonAttr(runConfig)}></script>
      )}
  </section>

  <section class:list={["env-section", envFiles.length === 0 && "am-hidden"]} data-env-section>
    <hr class="hairline" style="margin: 24px 0 0;" />
    <div class="sc" style="font-size: var(--fs-sm); letter-spacing: var(--track-label); margin-top: 12px;">Environments</div>
    <p class="env-intro">
      Rootstock runs each model family inside an isolated Python environment defined by a single file. This <a class="ink-link" href="https://garden-ai.github.io/rootstock/environments/">environment file</a> includes the specific dependencies needed, plus a <code>setup()</code> function that loads the model and returns an ASE calculator. These files are usually almost identical for a given model family, but because of cluster-specific quirks (eg, an old CUDA driver) the dependencies and setup code can vary a bit.
    </p>

    <div class="am-env-tabs" data-env-tabs>
      {envFiles.map((f, i) => (
        <button type="button" class:list={["am-env-tab", i === 0 && "is-active"]} data-env-tab={String(i)}>
          {f.clusterName}
        </button>
      ))}
    </div>

    <div class="am-env-block" data-env-block>
      <div class="am-env-chrome">
        <span class="am-env-filename" data-env-filename>{envFiles[0]?.filename ?? ''}</span>
        <button type="button" class="am-env-copy" data-env-copy aria-label="Copy environment file">
          <svg width="11" height="11" viewBox="0 0 16 16" aria-hidden="true" style="flex: 0 0 auto;">
            <rect x="5" y="5" width="9" height="9" rx="0.5" fill="none" stroke="currentColor" stroke-width="1.2" />
            <path d="M11 5V3.5a.5.5 0 0 0-.5-.5H2.5a.5.5 0 0 0-.5.5V11a.5.5 0 0 0 .5.5H5" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
          <span data-env-copy-label>copy</span>
        </button>
      </div>
      <div class="am-env-body" data-env-body set:html={envFiles[0] ? renderEnvBody(envFiles[0].source) : ''} />
    </div>
    <p class="am-env-caption" data-env-caption>{envFiles[0] ? envCaption(envFiles[0]) : ''}</p>
    <p class="am-env-error am-hidden" data-env-error>Couldn't load the current environments from Rootstock.</p>

    <script type="application/json" data-env-config set:html={jsonAttr(envConfig)}></script>
    <script type="application/json" data-env-seed set:html={jsonAttr(envFiles)}></script>
  </section>

  <hr class="hairline" style="margin: 18px 0 10px;" />

  <div class="model-body">
    <section>
      <header>
        <div class="sc" style="font-size: var(--fs-sm); letter-spacing: var(--track-label);">References</div>
      </header>
      {papers.length > 0 ? (
        <ol style="margin: 8px 0 0; padding-left: 24px; font-size: var(--fs-md); line-height: 1.5; color: var(--ink-2);">
          {papers.map((p) => {
            if (!p) return null;
            const cite = composeCitation(p.data);
            const href = p.data.doi ? `https://doi.org/${p.data.doi}` : p.data.url;
            return (
              <li style="margin-bottom: 6px; padding-left: 4px;">
                {href ? (
                  <a class="ink-link" href={href} target="_blank" rel="noopener">{cite}</a>
                ) : (
                  cite
                )}
              </li>
            );
          })}
        </ol>
      ) : (
        <p class="it" style="font-size: var(--fs-md); color: var(--ink-3); margin-top: 8px;">
          — no references catalogued yet —
        </p>
      )}
    </section>

    <aside class="spec-rail">
      <header>
        <div class="sc" style="font-size: var(--fs-sm); letter-spacing: var(--track-label);">Specifications</div>
      </header>
      <dl class="spec-list">
        {families.length > 0 && (
          <>
            <dt class="sc">{families.length > 1 ? 'Families' : 'Family'}</dt>
            <dd>
              {families.map((f, i) => f && (
                <>
                  {i > 0 && <span style="color: var(--ink-3);">, </span>}
                  <a class="ink-link" href={url(`/models#${f.id}`)}>{f.data.name}</a>
                </>
              ))}
            </dd>
          </>
        )}
        {trainingDatasets.length > 0 && (
          <>
            <dt class="sc">Trained on</dt>
            <dd>
              {trainingDatasets.map((d, i) => d && (
                <>
                  {i > 0 && <span style="color: var(--ink-3);">, </span>}
                  <a class="ink-link" href={url(`/datasets#${d.id}`)}>{d.data.name}</a>
                </>
              ))}
            </dd>
          </>
        )}
        {model.data.cachePath && (
          <>
            <dt class="sc">Cache path</dt>
            <dd><code class="mono" style="font-size: var(--fs-sm); color: var(--ink-2); word-break: break-all;">{model.data.cachePath}</code></dd>
          </>
        )}
      </dl>
    </aside>
  </div>

  {notesHtml && (
    <section class="model-notes">
      <hr class="hairline" style="margin: 18px 0 10px;" />
      <div class="sc" style="font-size: var(--fs-sm); letter-spacing: var(--track-label);">Notes</div>
      <div class="notes-body" set:html={notesHtml} />
    </section>
  )}
</Page>

<style>
  .model-masthead h1 {
    font-size: var(--fs-h1);
    line-height: 1.0;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin-top: 2px;
  }

  .masthead-links {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
  }
  .masthead-link {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .masthead-link .sc {
    font-family: var(--smallcaps);
    font-size: var(--fs-micro);
    letter-spacing: var(--track-label);
    color: var(--ink-3);
  }

  .checkpoint-matrix .matrix-legend {
    margin-top: 8px;
    font-size: var(--fs-sm);
    color: var(--ink-2);
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Server-render + live-refresh both toggle this class to drop cluster
     columns / status messages that don't apply per current Rootstock data. */
  .am-hidden { display: none; }

  .model-body {
    display: grid;
    grid-template-columns: 1fr 240px;
    column-gap: 32px;
    align-items: start;
  }
  .spec-rail {
    border-left: 0.5px solid var(--rule);
    padding-left: 18px;
  }
  .spec-list {
    display: grid;
    grid-template-columns: auto 1fr;
    row-gap: 5px;
    column-gap: 10px;
    margin: 10px 0 0;
    font-size: var(--fs-md);
  }
  .spec-list dt {
    font-family: var(--smallcaps);
    font-size: var(--fs-xs);
    letter-spacing: var(--track-label);
    color: var(--ink-3);
    padding-top: 1px;
    margin: 0;
  }
  .spec-list dd { margin: 0; }

  .notes-body {
    margin-top: 8px;
    font-size: var(--fs-md);
    line-height: 1.55;
    color: var(--ink);
    max-width: 720px;
  }
  .notes-body p { margin: 0 0 10px; }
  .notes-body ul { margin: 0 0 10px; padding-left: 18px; }
  .notes-body li { margin-bottom: 3px; }
  .notes-body code {
    font-family: var(--mono);
    background: rgba(26,22,18,0.05);
    padding: 0 4px;
  }
  .notes-body a { color: var(--oxblood); text-decoration: underline; text-decoration-thickness: 0.5px; text-underline-offset: 2px; }

  /* Running-this-model: prose + args table beside the worked snippet,
     mirroring the index How-To's two-column shape. */
  .running-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 32px;
    align-items: start;
    margin-top: 10px;
  }
  /* No heads → nothing to say in prose; the snippet stands
     alone at a readable measure instead of beside an empty column. */
  .running-grid.is-solo { grid-template-columns: minmax(0, 1fr); max-width: 760px; }
  .running-grid.is-solo .running-prose { display: none; }
  .running-prose p {
    margin: 0 0 10px;
    font-size: var(--fs-md);
    line-height: 1.55;
    color: var(--ink);
    max-width: 62ch;
  }
  .running-prose code {
    font-family: var(--mono);
    background: rgba(26,22,18,0.05);
    padding: 0 4px;
  }
  .running-args { font-size: var(--fs-md); margin: 4px 0 16px; }
  .running-args .mono { font-size: var(--fs-sm); }
  .running-head-default {
    margin-left: 8px;
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  /* Top-align the snippet block with the prose column (env-block ships a
     margin-top meant for the Environments section). */
  .running-grid :global(.running-snippet) { margin-top: 0; }
  .running-snippet-col { min-width: 0; }
  .running-snippet-col :global(.run-toggle) { margin-top: 0; }
  /* When the toggle is visible, give the snippet room below its tab rule. */
  .running-snippet-col :global(.run-toggle:not(.am-hidden) + .running-snippet) { margin-top: 12px; }

  @media (max-width: 860px) {
    .running-grid { grid-template-columns: 1fr; row-gap: 14px; }
  }

  @media (max-width: 720px) {
    .model-body { grid-template-columns: 1fr; }
    .spec-rail { border-left: 0; padding-left: 0; margin-top: 18px; }
  }
</style>

<script>
  import { loadLiveDump } from '../../lib/rootstock-client';
  import {
    findVerification,
    cellStateFor,
    statusGlyph,
    envFilesForModel,
    envCaption,
    renderEnvBody,
    type ModelEnvFile,
  } from '../../lib/rootstock';

  // Unlisted clusters count toward presence only for unlocked viewers
  // (html.gotigers, set pre-paint by Page.astro).
  const gotigers = document.documentElement.classList.contains('gotigers');
  const unlistedCols = new Set(
    Array.from(document.querySelectorAll<HTMLElement>('th[data-rs-col].am-unlisted')).map(
      (el) => el.dataset.rsCol!,
    ),
  );
  const counted = (cluster: string) => gotigers || !unlistedCols.has(cluster);

  loadLiveDump()
    .then((dump) => {
      const clusterHasPresence: Record<string, boolean> = {};
      let customPresent = false;
      document.querySelectorAll<HTMLElement>('[data-rs-cell]').forEach((td) => {
        // Split on the FIRST colon only — custom checkpoint ids contain one
        // ("perlmutter:mace:custom" → "perlmutter" / "mace:custom").
        const key = td.dataset.rsCell!;
        const cluster = key.slice(0, key.indexOf(':'));
        const checkpoint = key.slice(key.indexOf(':') + 1);
        const state = cellStateFor(findVerification(dump, cluster, checkpoint));
        td.innerHTML = statusGlyph(state);
        if (state !== 'na') {
          clusterHasPresence[cluster] = true;
          if (td.closest('[data-rs-custom-row]') && counted(cluster)) customPresent = true;
        }
      });
      // The custom row (and the snippet toggle) shows iff some visible
      // cluster currently reports the custom id — same rule as build time.
      document.querySelectorAll<HTMLElement>('[data-rs-custom-row]').forEach((tr) => {
        tr.classList.toggle('am-hidden', !customPresent);
      });
      runSnippet.setCustomAvailable(customPresent);
      // Toggle column visibility based on live presence (re-derived per page
      // load so a stale build doesn't drop a cluster that's since come up).
      document.querySelectorAll<HTMLElement>('[data-rs-col]').forEach((el) => {
        const cluster = el.dataset.rsCol!;
        el.classList.toggle('am-hidden', !clusterHasPresence[cluster]);
      });
      const anyPresence = Object.entries(clusterHasPresence).some(
        ([cluster, present]) => present && counted(cluster),
      );
      document.querySelectorAll<HTMLElement>('[data-rs-legend]').forEach((el) => {
        el.classList.toggle('am-hidden', !anyPresence);
      });
      document.querySelectorAll<HTMLElement>('[data-rs-empty]').forEach((el) => {
        el.classList.toggle('am-hidden', anyPresence);
      });
    })
    .catch((err) => console.warn('Rootstock live refresh failed', err));

  // ── Environments section ──────────────────────────────────────────────
  // Build emits a best-effort seed (fixture source) plus a config blob; here
  // we wire local tab-switching off the seed, then re-derive the whole section
  // from the live dump. Tabs switch with no further network. On a genuine live
  // fetch failure we show the error state and never fall back to seed text; if
  // no live URL is configured at all (the offline-clean default), the fixture
  // seed is authoritative and we keep it.
  function setupEnvSection() {
    const section = document.querySelector<HTMLElement>('[data-env-section]');
    if (!section) return;

    const readJson = <T,>(sel: string): T =>
      JSON.parse(section.querySelector(sel)!.textContent || 'null') as T;
    const config = readJson<{
      clusters: { id: string; name: string; unlisted?: boolean }[];
      checkpoints: string[];
    }>('[data-env-config]');
    // Same unlock rule as the matrix: unlisted clusters get env tabs only
    // for unlocked viewers.
    const eggOn = document.documentElement.classList.contains('gotigers');
    const tabClusters = config.clusters.filter((c) => eggOn || !c.unlisted);

    const tabsEl = section.querySelector<HTMLElement>('[data-env-tabs]')!;
    const blockEl = section.querySelector<HTMLElement>('[data-env-block]')!;
    const filenameEl = section.querySelector<HTMLElement>('[data-env-filename]')!;
    const bodyEl = section.querySelector<HTMLElement>('[data-env-body]')!;
    const captionEl = section.querySelector<HTMLElement>('[data-env-caption]')!;
    const errorEl = section.querySelector<HTMLElement>('[data-env-error]')!;
    const copyBtn = section.querySelector<HTMLElement>('[data-env-copy]')!;
    const copyLabel = section.querySelector<HTMLElement>('[data-env-copy-label]')!;

    let files: ModelEnvFile[] = readJson<ModelEnvFile[]>('[data-env-seed]') ?? [];
    let active = 0;
    let copyTimer: number | undefined;

    const resetCopy = () => {
      if (copyTimer) clearTimeout(copyTimer);
      copyLabel.textContent = 'copy';
      copyBtn.classList.remove('is-copied');
    };

    const paint = () => {
      tabsEl.innerHTML = files
        .map((f, i) =>
          `<button type="button" class="am-env-tab${i === active ? ' is-active' : ''}" data-env-tab="${i}">${f.clusterName}</button>`,
        )
        .join('');
      tabsEl.querySelectorAll<HTMLElement>('[data-env-tab]').forEach((btn) => {
        btn.addEventListener('click', () => {
          active = Number(btn.dataset.envTab);
          resetCopy();
          paint();
        });
      });
      const f = files[active];
      if (!f) return;
      filenameEl.textContent = f.filename;
      bodyEl.innerHTML = renderEnvBody(f.source);
      captionEl.textContent = envCaption(f);
    };

    copyBtn.addEventListener('click', () => {
      const f = files[active];
      if (!f) return;
      const done = () => {
        copyLabel.textContent = 'copied';
        copyBtn.classList.add('is-copied');
        if (copyTimer) clearTimeout(copyTimer);
        copyTimer = window.setTimeout(resetCopy, 1600);
      };
      try {
        if (navigator.clipboard?.writeText) navigator.clipboard.writeText(f.source).then(done, done);
        else done();
      } catch {
        done();
      }
    });

    paint();
    section.classList.toggle('am-hidden', files.length === 0);

    loadLiveDump()
      .then((dump) => {
        files = envFilesForModel(dump, tabClusters, config.checkpoints);
        active = 0;
        resetCopy();
        blockEl.classList.remove('am-hidden');
        captionEl.classList.remove('am-hidden');
        errorEl.classList.add('am-hidden');
        paint();
        section.classList.toggle('am-hidden', files.length === 0);
      })
      .catch((err: unknown) => {
        // No live URL configured → keep the fixture seed (offline-clean default).
        if (/not set/i.test((err as Error)?.message ?? '')) return;
        // Genuine live-fetch failure → error state, never stale file text.
        blockEl.classList.add('am-hidden');
        captionEl.classList.add('am-hidden');
        errorEl.classList.remove('am-hidden');
      });
  }
  setupEnvSection();

  // ── Run snippet: template re-renders ─────────────────────────────────
  // Two client-side inputs re-render the snippet from its templates: a
  // matrix head link (?head=…) pre-fills that head, and the shipped/custom
  // toggle — or a matrix ?custom link — swaps in the bring-your-own-weights
  // variant. The toggle's visibility follows live custom-id presence (see
  // setCustomAvailable, driven by the refresh above).
  function setupRunSnippet() {
    const noop = { setCustomAvailable: (_present: boolean) => {} };
    const cfgEl = document.querySelector('script[data-run-config]');
    const body = document.querySelector<HTMLElement>('[data-run-snippet]');
    if (!cfgEl || !body) return noop;
    const cfg = JSON.parse(cfgEl.textContent ?? 'null') as {
      template: string;
      customTemplate: string | null;
      heads: string[];
      defaultHead: string | null;
    } | null;
    if (!cfg) return noop;

    const toggle = document.querySelector<HTMLElement>('[data-run-toggle]');
    const params = new URLSearchParams(location.search);
    const urlHead = params.get('head');
    const head = urlHead && cfg.heads.includes(urlHead) ? urlHead : cfg.defaultHead;
    let mode: 'shipped' | 'custom' =
      params.has('custom') && cfg.customTemplate ? 'custom' : 'shipped';

    const render = () => {
      const tpl = mode === 'custom' && cfg.customTemplate ? cfg.customTemplate : cfg.template;
      body.innerHTML = renderEnvBody(head ? tpl.split('@@HEAD@@').join(head) : tpl);
      toggle?.querySelectorAll<HTMLElement>('[data-run-mode]').forEach((btn) => {
        btn.classList.toggle('is-active', btn.dataset.runMode === mode);
      });
    };

    toggle?.querySelectorAll<HTMLElement>('[data-run-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        mode = btn.dataset.runMode === 'custom' ? 'custom' : 'shipped';
        render();
      });
    });

    render();

    return {
      setCustomAvailable(present: boolean) {
        toggle?.classList.toggle('am-hidden', !present);
        if (!present && mode === 'custom') {
          mode = 'shipped';
          render();
        }
      },
    };
  }
  const runSnippet = setupRunSnippet();
</script>
