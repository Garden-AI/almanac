        <text x="656" y="198" class="t-xs t-lab" text-anchor="end">simulation time →</text>
        <!-- conservative flat -->
        <path d="M80 120 L 660 120" fill="none" class="s-acc" stroke-width="2"/>
        <text x="500" y="112" class="t-xs t-acc">conservative: flat = pass</text>
        <!-- direct drift -->
        <path d="M80 120 C 300 118, 440 96, 660 56" fill="none" class="s-ink" stroke-width="1.6" stroke-dasharray="4 3"/>
