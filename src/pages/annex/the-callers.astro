        <text x="700" y="28" class="t-xs t-lab" text-anchor="end">wall time → (not to scale)</text>
        <line x1="120" y1="36" x2="700" y2="36" class="s-rule" stroke-width="1" />

        <!-- lane: plain MD -->
        <text x="108" y="90" class="t-s t-ink" text-anchor="end">plain MD</text>
        <rect x="120" y="76" width="30" height="18" class="f-wash s-acc" stroke-width="1" stroke-dasharray="3 3" />
        {MD_TICKS.map((x) => <line x1={x} y1={76} x2={x} y2={94} class="s-acc" stroke-width="1" />)}
        <text x="120" y="116" class="t-xs t-lab">one process · each call fed by the last · state stays warm</text>

        <!-- lane: calphy -->
        <text x="108" y="162" class="t-s t-ink" text-anchor="end">calphy</text>
